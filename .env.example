# StatFin AI Environment Configuration
# Copy this file to .env.local to configure optional server-side AI interpretations.
# If these variables are omitted, the application will automatically run the local deterministic fallback agent.

# Specify the AI API provider: "gemini" (or "google") or "openai"
AI_PROVIDER=gemini

# Insert your respective provider's API key
AI_API_KEY=your_api_key_here
